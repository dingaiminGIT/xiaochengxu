<view wx:if="{{!modalHidden}}" class="tab-bar {{value === 'assistant' ? 'assistant-tab-bar' : 'design-tab-bar'}}"><button wx:for="{{list}}" wx:key="value" class="tab-item {{value === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="handleChange" aria-label="{{item.label}}" aria-current="{{value === item.value ? 'page' : ''}}"><view wx:if="{{value === 'assistant'}}" class="assistant-tab-icon"><image src="/static/assistant/welcome/tab-{{item.value === 'my' ? 'pet' : item.value}}.svg" class="assistant-tab-image-{{item.value}}" mode="aspectFit" /></view><view wx:else class="design-tab-icon"><image src="/static/design/{{value === 'my' ? 'pet' : 'home'}}-tab-{{item.value}}.svg" class="design-tab-image-{{item.value}}" mode="aspectFit" /></view><text>{{item.label}}</text></button></view>
