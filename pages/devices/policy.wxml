<view class="page"><page-header title="{{title}}" back /><view class="device-body"><text wx:if="{{loading}}">正在读取…</text><view wx:if="{{error}}" class="device-notice">{{error}}<button class="device-link" bindtap="load">重新加载</button></view><text class="device-caption">{{version}}</text><view wx:for="{{sections}}" wx:key="title" class="device-card"><text class="device-card-title">{{item.title}}</text><text selectable class="device-caption">{{item.content}}</text></view></view></view>
