<view class="page chat-layout {{compactWelcome ? 'compact-welcome' : ''}} {{!chatMessages.length ? 'welcome-mode' : 'conversation-mode'}} {{keyboardHeight ? 'keyboard-open' : ''}}" style="{{keyboardHeight ? 'height:calc(100vh - ' + keyboardHeight + 'px)' : ''}}">
  <view class="chat-header"><page-header title="宠物管家" /></view>
  <view wx:if="{{chatMessages.length}}" class="active-chat-toolbar"><button class="text-button new-conversation-button" bindtap="newConversation"><p-icon name="chat-new" size="26" />新建会话</button><button class="text-button history-button" bindtap="openConversationHistory"><p-icon name="history" size="26" />对话记录</button></view>
  <scroll-view class="chat-message-scroll {{chatMessages.length ? 'has-messages' : ''}}" scroll-y scroll-top="{{chatScrollTop}}" scroll-with-animation enhanced show-scrollbar="{{false}}"><view class="content {{!recognized ? 'initial-content' : ''}}">
    <view wx:if="{{savedMode}}" class="saved-card">
        <view class="saved-head">
          <view class="saved-icon">▧</view>
          <text>上次未完成的换粮对话</text>
          <text class="autosave">已自动保存</text>
          <view class="delete-saved" catchtap="deleteSavedConversation">删除</view>
        </view>
        <view class="saved-title">{{savedDraft.userMessage || '上次换粮对话'}} <text>›</text></view>
        <view class="saved-detail">当前粮：{{savedDraft.currentFood.brand}} {{savedDraft.currentFood.name}}　·　目标粮：{{savedDraft.targetFood.brand}} {{savedDraft.targetFood.name}}</view>
        <view class="saved-time">最近自动保存</view>
        <button class="continue-button" data-action="resume" bindtap="continueConversation">继续对话　›</button>
      </view>

    <view wx:if="{{!chatMessages.length}}" class="chat-welcome">
      <view class="welcome-hero">
        <image class="welcome-pets" src="/static/design/assistant-hero.png" mode="aspectFit" aria-label="依偎在一起的猫咪和狗狗" />
        <button class="welcome-history" bindtap="openConversationHistory" aria-label="打开对话记录">◷ 对话记录</button>
        <text class="welcome-star welcome-star-left" aria-hidden="true">✦</text>
        <text class="welcome-star welcome-star-right" aria-hidden="true">✧</text>
        <view class="welcome-copy">
          <text class="welcome-title">养宠小事，随时问我</text>
          <text class="welcome-description">饮食、状态、日常照护，陪你一起理清楚</text>
        </view>
      </view>
      <view class="welcome-shortcuts">
        <button wx:for="{{welcomeShortcuts}}" wx:key="id" class="shortcut-card" hover-class="welcome-pressed" data-id="{{item.id}}" bindtap="useWelcomeShortcut" aria-label="{{item.label}}">
          <view class="shortcut-icon shortcut-icon-{{item.id}}"><image src="/static/assistant/welcome/{{item.id}}.svg" style="width:{{item.iconWidth}}rpx;height:{{item.iconHeight}}rpx" mode="aspectFit" /></view>
          <text>{{item.label}}</text>
        </button>
      </view>
      <view class="welcome-suggestions">
        <view class="suggestion-heading"><text>今天想聊点什么？</text><text class="suggestion-hint">试试这样问</text></view>
        <view class="quick-prompts">
          <button data-message="最近软便，换粮要注意什么？" bindtap="usePrompt" hover-class="welcome-pressed"><text>最近软便，换粮要注意什么？</text><image src="/static/assistant/welcome/right.svg" mode="aspectFit" /></button>
          <button data-message="毛孩子不爱玩，怎么陪它玩？" bindtap="usePrompt" hover-class="welcome-pressed"><text>毛孩子不爱玩，怎么陪它玩？</text><image src="/static/assistant/welcome/right.svg" mode="aspectFit" /></button>
          <button bindtap="openIngredientSheet" hover-class="welcome-pressed"><text>这款粮 / 零食适合它吗？</text><image src="/static/assistant/welcome/right.svg" mode="aspectFit" /></button>
        </view>
      </view>
    </view>
    <view class="conversation-thread"><view wx:for="{{chatMessages}}" wx:key="id" class="thread-message {{item.role}} {{item.response_type === 'risk_alert' ? 'risk-message' : ''}}"><view wx:if="{{item.role === 'assistant'}}" class="assistant-label"><view class="reply-avatar"><p-icon name="cat" tone="accentText" size="32" /></view><text>宠物管家</text></view><view wx:if="{{item.images && item.images.length}}" class="message-images"><image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="message-image" src="{{img}}" mode="aspectFill" data-current="{{img}}" bindtap="previewComposerImage" /></view><view wx:if="{{item.healthSubjects.length || item.text || item.riskReasons || item.limitedInfo || item.response_type === 'processing'}}" class="message-body {{item.knowledgeCards.length ? 'knowledge-body' : ''}}"><view wx:if="{{item.healthSubjects.length}}" class="health-analysis">
  <view wx:if="{{item.healthOverview}}" class="health-subject health-overview">
    <text class="health-product" selectable>{{item.healthOverview.title}}</text>
    <block wx:if="{{item.healthOverview.advantages.length}}"><text class="health-section positive">✅ 好在哪里？</text><text wx:for="{{item.healthOverview.advantages}}" wx:for-item="point" wx:key="id" class="health-detail" selectable><text wx:if="{{point.title}}" class="health-title">{{point.title}}：</text>{{point.summary}}</text></block>
    <block wx:if="{{item.healthOverview.attentions.length}}"><text class="health-section attention">❗ 哪里需要留心？</text><text wx:for="{{item.healthOverview.attentions}}" wx:for-item="point" wx:key="id" class="health-detail" selectable><text wx:if="{{point.title}}" class="health-title">{{point.title}}：</text>{{point.summary}}</text></block>
    <text wx:for="{{item.healthOverview.unavailable_subjects}}" wx:for-item="name" wx:key="*this" class="health-note">资料不足：{{name}}</text>
    <text class="health-note" selectable>{{item.healthOverview.note}}</text>
  </view>
  <view wx:for="{{item.healthSubjects}}" wx:for-item="subject" wx:key="index" class="health-subject">
    <text class="health-product" selectable>{{subject.label}}</text>
    <text wx:if="{{subject.roleText}}" class="health-note">{{subject.roleText}}</text>
    <block wx:if="{{subject.hasPresentation}}">
      <block wx:if="{{subject.advantages.length}}"><text class="health-section positive">✅ 1. 好在哪？</text><view wx:for="{{subject.advantages}}" wx:for-item="point" wx:key="title" class="health-point"><text class="health-detail" selectable><text wx:if="{{point.title}}" class="health-title">{{point.title}}：</text>{{point.summary}}</text></view></block>
      <block wx:if="{{subject.attentions.length}}"><text class="health-section attention">❗ 2. 哪里需要留心？</text><view wx:for="{{subject.attentions}}" wx:for-item="point" wx:key="title" class="health-point"><text class="health-detail" selectable><text wx:if="{{point.title}}" class="health-title">{{point.title}}：</text>{{point.summary}}</text></view><text class="health-note">{{subject.presentation.note}}</text></block>
      <text wx:if="{{!subject.advantages.length && !subject.attentions.length}}" class="health-note" selectable>{{subject.message}}</text>
    </block>
    <block wx:else><text wx:if="{{!subject.concerns.length}}" class="health-note" selectable>{{subject.message}}</text><view wx:for="{{subject.concerns}}" wx:for-item="concern" wx:key="title" class="health-concern">
      <view class="health-concern-heading"><text class="health-title" selectable>{{concern.title}}</text><text class="health-tag health-tag-{{concern.kind}}">{{concern.tag}}</text></view>
      <text class="health-evidence" selectable>{{concern.evidence_text}}</text>
      <text class="health-detail" selectable>{{concern.mechanism_text}}</text>
      <text class="health-observation" selectable>❗ {{concern.observation_text}}</text>
    </view></block>
    <text wx:if="{{subject.missingText}}" class="health-note" selectable>资料不足：{{subject.missingText}}</text>
    <text wx:if="{{subject.unmappedText}}" class="health-note" selectable>暂缺对应知识：{{subject.unmappedText}}</text>
    <text wx:if="{{!subject.hasPresentation && subject.skippedText}}" class="health-note" selectable>中间档暂不解读：{{subject.skippedText}}</text>
    <text wx:if="{{!subject.hasPresentation}}" class="health-note" selectable>{{subject.note}}</text>
  </view>
  <view wx:for="{{item.healthComparisons}}" wx:for-item="comparison" wx:key="index" class="health-subject">
    <text class="health-product" selectable>{{comparison.left}} 与 {{comparison.right}} · 对比</text>
    <text class="health-detail" selectable>{{comparison.text}}</text>
  </view>
  <text wx:if="{{item.healthCoverage}}" class="health-note">{{item.healthCoverage}}</text><text class="health-prompt">{{item.healthPrompt}}</text>
</view><view wx:elif="{{item.knowledgeCards.length}}" class="knowledge-answer">
  <view wx:for="{{item.knowledgeCards}}" wx:for-item="card" wx:for-index="cardIndex" wx:key="type" class="knowledge-card knowledge-{{card.type}}">
    <view class="knowledge-heading"><text class="knowledge-icon">{{card.icon}}</text><text>{{card.title}}</text></view>
    <view wx:if="{{card.questions.length}}" class="knowledge-questions"><button wx:for="{{card.questions}}" wx:for-item="question" wx:for-index="questionIndex" wx:key="*this" class="knowledge-question" data-id="{{item.id}}" data-card-index="{{cardIndex}}" data-question-index="{{questionIndex}}" bindtap="askKnowledgeQuestion" disabled="{{sending}}">{{question}}</button></view>
    <rich-text wx:else nodes="{{card.nodes}}" user-select class="knowledge-content" />
  </view>
  <text wx:if="{{item.knowledgeNote}}" class="knowledge-review-note">❗ {{item.knowledgeNote}}</text>
</view><view wx:elif="{{item.blocks.length}}" class="assistant-blocks"><view wx:for="{{item.blocks}}" wx:for-item="block" wx:key="index" class="assistant-block"><text selectable><text wx:if="{{block.marker}}">{{block.marker}} </text><text wx:for="{{block.segments}}" wx:for-item="segment" wx:key="index" class="{{segment.strong ? 'assistant-emphasis' : ''}}">{{segment.text}}</text></text></view></view><text wx:else selectable>{{item.text}}</text><text wx:if="{{item.riskReasons}}" class="risk-reasons">需要留意：{{item.riskReasons}}</text>
<text wx:if="{{item.limitedInfo}}" class="chat-limited">信息有限，可补充情况让回答更准确。</text>
<view wx:if="{{item.response_type === 'processing'}}" class="chat-limited">正在识别食品投稿，可在投稿页查看自动更新的结果。</view>
</view>
<view wx:if="{{item.canInteract || item.interaction.options.length}}" class="chat-options">
<button size="mini" wx:for="{{item.interaction.options}}" wx:for-item="option" wx:for-index="optionIndex" wx:key="value" hover-class="chat-option-hover" class="chat-option {{option.selected ? 'selected' : ''}}" data-id="{{item.id}}" data-index="{{optionIndex}}" bindtap="chooseChatOption" disabled="{{sending || !item.canInteract}}">{{option.label}}</button>
<button wx:if="{{item.canInteract && item.response_type === 'multi_select'}}" size="mini" hover-class="chat-option-hover" class="chat-option selected" data-id="{{item.id}}" bindtap="submitChatOptions" disabled="{{sending || !item.selectedValues.length}}">确认选择</button>
<button wx:if="{{item.canInteract && (item.response_type === 'food_select' || item.response_type === 'text_or_select' || item.response_type === 'ingredient_source')}}" size="mini" hover-class="chat-option-hover" class="chat-option" bindtap="openFoodSubmission" disabled="{{sending}}">手动补充</button>
</view>
<view wx:if="{{item.candidates.length && item.result.recommendation.status === 'ready'}}" class="guardian-candidates"><view wx:for="{{item.candidates}}" wx:for-item="candidate" wx:for-index="candidateIndex" wx:key="catalog_key" class="guardian-candidate"><text class="section-title">{{candidate.brand}} {{candidate.product_name}}</text><text class="caption">{{candidate.stageLabel}} · 结构参考分 {{candidate.fit_score}}</text><text wx:for="{{candidate.strengths}}" wx:for-item="strength" wx:key="*this" class="caption">✅ {{strength}}</text><text wx:for="{{candidate.cautions}}" wx:for-item="caution" wx:key="*this" class="caption">❗ 需留意：{{caution}}</text><button class="chat-option" data-id="{{item.id}}" data-index="{{candidateIndex}}" bindtap="viewCandidate" disabled="{{sending}}">查看详情</button><button class="chat-option" data-id="{{item.id}}" data-index="{{candidateIndex}}" bindtap="confirmCandidateDiet" disabled="{{sending}}">已开始吃这款，更新口粮</button></view><button class="chat-option" bindtap="requestOtherCandidates" disabled="{{sending}}">换一组</button><text class="caption">{{item.recommendationNote}}</text></view>
<button wx:if="{{item.canRecordDaily}}" class="chat-option daily-record-entry" data-id="{{item.id}}" bindtap="openDailyRecord" disabled="{{sending || dailyRecordSaving}}">记录 / 更新日常次数</button>
<view wx:if="{{item.actions.length}}" class="chat-options"><button wx:for="{{item.actions}}" wx:for-item="action" wx:for-index="actionIndex" wx:key="type" class="chat-option" data-id="{{item.id}}" data-index="{{actionIndex}}" bindtap="useGuardianAction" disabled="{{sending}}">{{action.type === 'medical_record' ? '补充健康档案' : action.label}}</button></view>
<button wx:if="{{item.error && item.cloudError}}" class="retry-button" bindtap="retryCloudMessage">重新发送</button><button wx:elif="{{item.error}}" class="retry-button" bindtap="retryMessage">重新发送</button></view><view wx:if="{{sending}}" class="loading-message"><view class="typing-dot"></view><view class="typing-dot"></view><view class="typing-dot"></view><text>正在整理你的问题</text></view></view>
    <view wx:if="{{recognized}}" class="ready-block">
      <p-icon name="cat" size="48" />
      <text class="ready-title">我已整理好你的换粮信息</text>
      <text class="ready-subtitle">请确认后开始分析</text>
    </view>

    <view wx:if="{{recognized}}" class="confirm-card">
      <view class="confirm-head">
        <text class="confirm-heading">换粮信息</text>
        <view class="modify" bindtap="focusComposer">⌕ 修改</view>
      </view>
      <view class="info-list">
        <view class="info-row" data-type="current" bindtap="openFoodSheet">
          <view class="row-icon pink">♙</view>
          <text class="label">当前粮</text>
          <text class="value">{{currentFood.brand}} {{currentFood.name}}</text>
          <text class="chevron">›</text>
        </view>
        <view class="info-row" data-type="target" bindtap="openFoodSheet">
          <view class="row-icon green">⌁</view>
          <text class="label">目标粮</text>
          <text class="value">{{targetFood.brand}} {{targetFood.name}}</text>
          <text class="chevron">›</text>
        </view>
        <view class="info-row" bindtap="openSymptoms">
          <view class="row-icon yellow"><p-icon name="cat" tone="accentText" /></view>
          <text class="label">猫咪状态</text>
          <text class="value symptom">{{symptomText}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
      <button class="primary-action" loading="{{testing}}" bindtap="startTest">{{testing ? '正在分析...' : '开始换粮分析'}}</button>
    </view>
  </view></scroll-view>

  <view wx:if="{{showExitModal}}" class="exit-mask" bindtap="continueConversation"></view>
  <view wx:if="{{showExitModal}}" class="exit-modal">
    <p-icon name="cat" size="64" />
    <text class="exit-title">退出当前对话？</text>
    <text class="exit-desc">本次换粮信息会自动保存，下次可继续
补充和分析。</text>
    <view class="exit-summary">已识别：当前粮、目标粮、猫咪状态</view>
    <button class="leave-button" bindtap="directLeave">直接离开</button>
    <button class="stay-button" bindtap="continueConversation">继续对话</button>
  </view>

  <view wx:if="{{showFoodSheet || showSymptomSheet || showIngredientSheet}}" class="mask" bindtap="closeSheet"></view>
  <view wx:if="{{showFoodSheet}}" class="sheet {{showFoodSheet ? 'open' : ''}}">
    <view class="sheet-head"><text>{{foodTitle}}</text><text bindtap="closeSheet">×</text></view>
    <view wx:if="{{loadingFoods}}" class="food-loading">正在加载该品牌的产品…</view>
    <view wx:for="{{foodOptions}}" wx:key="id" class="food-option" data-id="{{item.id}}" bindtap="chooseFood"><view class="option-image">{{item.emoji}}</view><view><text class="option-brand">{{item.brand}}</text><text class="option-name">{{item.name}}</text></view><text class="check">{{item.selected ? '✓' : ''}}</text></view>
    <view wx:if="{{!loadingFoods && !foodOptions.length}}" class="food-loading">该品牌暂无可选择的产品</view>
  </view>
  <view wx:if="{{showSymptomSheet}}" class="sheet {{showSymptomSheet ? 'open' : ''}}">
    <view class="sheet-head"><text>编辑猫咪状态</text><text bindtap="closeSheet">×</text></view>
    <view class="symptom-grid"><view wx:for="{{symptomOptions}}" wx:key="label" class="chip {{item.selected ? 'selected' : ''}}" data-label="{{item.label}}" bindtap="toggleSymptom">{{item.selected ? '✓ ' : ''}}{{item.label}}</view></view>
    <button class="confirm" bindtap="confirmSymptoms">确认</button>
  </view>
  <view wx:if="{{showIngredientSheet}}" class="sheet open ingredient-sheet">
    <view class="sheet-head"><text>拍摄示例</text><text bindtap="closeSheet">×</text></view>
    <view class="ingredient-sample" bindtap="previewIngredientExample">
      <image class="ingredient-sample-image" src="/static/assistant/ingredient-example.jpg" mode="aspectFill" />
      <text class="ingredient-sample-tip">必须同时包含完整配料表和营养成分保证值；若在不同包装面，请分别拍摄并一起上传。</text>
    </view>
    <text class="ingredient-format-hint">支持 1~3 张 JPG、PNG、WEBP，单张不超过 10MB</text>
    <button class="ingredient-found-button" bindtap="onIngredientFound">选择或拍照</button>
  </view>
<view wx:if="{{!showDailyRecord && !showFoodSheet && !showSymptomSheet && !showIngredientSheet && !showExitModal && !showChatPetPicker}}" class="chat-input-dock"><view class="chat-input-box"><button wx:if="{{composerPet}}" class="composer-pet" bindtap="openChatPetPicker" disabled="{{sending}}" aria-label="切换咨询宠物"><p-image wx:if="{{composerPet.image}}" image-class="composer-pet-photo" src="{{composerPet.image}}" /><view wx:else class="composer-pet-fallback"><p-icon name="{{composerPet.type === '狗狗' ? 'dog' : 'cat'}}" tone="accentText" size="32" /></view><text>{{composerPet.name}}</text><p-icon name="arrow" tone="muted" size="22" /></button><view wx:if="{{composerImages.length}}" class="composer-images"><view wx:for="{{composerImages}}" wx:key="*this" class="composer-image" data-current="{{item}}" bindtap="previewComposerImage"><image src="{{item}}" mode="aspectFill" /><button class="composer-image-remove" data-index="{{index}}" catchtap="removeComposerImage" aria-label="移除图片"><p-icon name="close" tone="inverse" size="20" /></button></view></view><view class="composer-row"><button class="composer-camera" bindtap="onIngredientFound" disabled="{{sending}}" aria-label="拍照或上传图片"><image src="/static/assistant/welcome/camera.svg" mode="aspectFit" /></button><textarea class="chat-textarea" focus="{{composerFocused}}" bindfocus="focusChatInput" bindblur="blurComposer" value="{{inputMessage}}" placeholder="聊聊你家毛孩子…" auto-height placeholder-class="composer-placeholder" maxlength="4000" fixed adjust-position="{{false}}" cursor-spacing="20" show-confirm-bar="{{false}}" confirm-type="send" bindinput="onMessageInput" bindconfirm="sendMessage" bindkeyboardheightchange="onKeyboardChange" /><view class="input-actions"><button class="composer-voice" bindtap="useKeyboardVoice" aria-label="使用系统键盘语音输入"><image src="/static/assistant/welcome/voice.svg" mode="aspectFit" /></button><button wx:if="{{sending}}" class="send-button" bindtap="stopSending" aria-label="停止生成"><p-icon name="stop" tone="inverse" size="26" /></button><button wx:else class="send-button" disabled="{{!(inputMessage || composerImages.length)}}" bindtap="sendMessage" aria-label="发送"><image class="send-arrow" src="/static/assistant/welcome/send.svg" mode="aspectFit" /></button></view></view><button wx:if="{{!composerPet && (chatMessages.length || keyboardHeight || inputMessage || composerImages.length)}}" class="composer-pet-select" bindtap="openChatPetPicker" disabled="{{sending || petsLoading}}"><p-icon name="{{boundPet.type === '狗狗' ? 'dog' : 'cat'}}" size="26" /><text>{{boundPet.name || '选择咨询宠物'}}</text><p-icon name="arrow" tone="muted" size="20" /></button></view><view class="chat-disclaimer">AI 内容仅供参考，不能替代兽医诊断</view></view>
</view>

<view wx:if="{{showPetGate}}" class="pet-gate-mask">
  <view class="pet-gate-card" role="dialog" aria-label="还没有添加任何宠物哦">
    <view class="pet-gate-title">还没有添加任何宠物哦</view>
    <text class="pet-gate-description">为了让管家的回答更准确，请先绑定宠物信息。绑定后可继续发送，当前内容会保留。</text>
    <view class="pet-gate-actions"><button class="secondary-button" data-action="cancel" bindtap="resolvePetGate">取消</button><button class="primary-button" data-action="bind" bindtap="resolvePetGate">去绑定宠物</button></view>
  </view>
</view>

<view wx:if="{{showChatPetPicker}}" class="sheet-mask" bindtap="closeChatPetPicker"></view>
<view wx:if="{{showChatPetPicker}}" class="bottom-sheet chat-pet-sheet"><view class="sheet-heading"><text>这次聊聊谁？</text><button bindtap="closeChatPetPicker" aria-label="关闭"><p-icon name="close" /></button></view><text class="caption">选择宠物，让管家了解它的资料。</text><view class="chat-pet-options"><button wx:for="{{chatPets}}" wx:key="id" class="chat-pet-option {{boundPet.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectChatPet"><p-image wx:if="{{item.image}}" image-class="chat-pet-photo" src="{{item.image}}" /><view wx:else class="chat-pet-placeholder"><p-icon name="{{item.type === '狗狗' ? 'dog' : 'cat'}}" tone="accentText" size="46" /></view><view class="chat-pet-copy"><text>{{item.name}}</text><text class="caption">{{item.breed || item.type}}</text></view><text wx:if="{{boundPet.id === item.id}}" class="caption">已选择</text></button></view></view>

<view wx:if="{{showDailyRecord}}" class="sheet-mask" bindtap="closeDailyRecord"></view>
<view wx:if="{{showDailyRecord}}" class="bottom-sheet daily-record-sheet">
  <view class="sheet-heading"><text>解读前，先了解它的日常</text><button bindtap="closeDailyRecord" disabled="{{dailyRecordSaving}}" aria-label="关闭"><p-icon name="close" /></button></view>
  <view class="status-guide-pet">本次记录 · {{boundPet.name}}</view>
  <text class="caption">补充真实记录，帮助管家了解变化。没有设备也可以填写。</text>
  <view class="status-guide-section">
    <text class="status-guide-title">01 记录来自哪里</text>
    <view class="form-field"><text>数据来源</text><picker mode="selector" range="{{dailyRecordSources}}" value="{{dailyRecordForm.source === 'reported_device' ? 1 : 0}}" bindchange="changeDailySource" disabled="{{dailyRecordLoading || dailyRecordSaving}}"><view class="form-value">{{dailyRecordForm.source === 'reported_device' ? '设备统计（手工填写）' : '手动记录'}}⌄</view></picker></view>
    <block wx:if="{{dailyRecordForm.source === 'reported_device'}}">
      <view class="form-field"><text>设备信息（选填）</text><input value="{{dailyRecordDevice}}" maxlength="80" bindinput="inputDailyDevice" disabled="{{dailyRecordSaving}}" placeholder="设备类型 / 品牌 / 型号" /></view>
      <text class="caption">查看喂食器、饮水机或猫砂盆的统计，再填写下方次数。设备信息仅用于本次解读，不代表连接设备。</text>
    </block>
    <text wx:else class="caption">按实际观察填写，不确定的项目可以留空。</text>
  </view>
  <view class="status-guide-section">
    <text class="status-guide-title">02 补充日常次数</text>
    <view class="form-field"><text>记录日期</text><picker mode="date" start="{{dailyRecordFirstDay}}" end="{{dailyRecordToday}}" value="{{dailyRecordForm.day}}" bindchange="changeDailyRecordDay" disabled="{{dailyRecordSaving}}"><view class="form-value">{{dailyRecordForm.day}} ⌄</view></picker></view>
    <text class="caption">填写所选日期的总次数，重复保存会覆盖。0 表示实际未发生，留空表示未知。</text>
    <text wx:if="{{dailyRecordLoading}}" class="caption">正在读取这天的记录…</text>
    <text wx:if="{{dailyRecordError}}" class="record-error">{{dailyRecordError}}，尚未保存。</text><button wx:if="{{dailyRecordError}}" class="chat-option" bindtap="retryDailyRecord" disabled="{{dailyRecordLoading}}">重新读取</button>
    <view wx:for="{{dailyRecordFields}}" wx:key="key" class="form-field status-count-field"><text>{{item.label}}（{{item.unit}}）</text><input type="number" maxlength="3" value="{{dailyRecordForm[item.key]}}" data-key="{{item.key}}" bindinput="inputDailyRecord" disabled="{{dailyRecordLoading || dailyRecordSaving || dailyRecordError}}" placeholder="未知可留空" /></view>
    <view class="daily-coverage"><text>已记录完整一天</text><switch checked="{{dailyRecordForm.complete_day}}" disabled="{{dailyRecordForm.day === dailyRecordToday || dailyRecordSaving}}" bindchange="changeDailyCoverage" /></view>
    <text wx:if="{{dailyRecordForm.day === dailyRecordToday}}" class="caption">今天尚未结束，按截至目前记录。</text>
  </view>
  <view class="status-guide-actions"><button class="secondary-button" bindtap="closeDailyRecord" disabled="{{dailyRecordSaving}}">暂不填写</button><button class="primary-button" bindtap="saveDailyRecord" loading="{{dailyRecordSaving}}" disabled="{{dailyRecordLoading || dailyRecordSaving || dailyRecordError}}">保存并解读</button></view>
</view>
