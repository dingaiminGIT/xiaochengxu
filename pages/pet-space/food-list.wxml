<view class="page has-page-actions"><page-header title="{{history ? '历史口粮' : '口粮清单'}}" back /><view class="screen-body">
<view class="section-heading">{{pet ? pet.name + '的' + (history ? '历史口粮' : '清单') : ''}}</view>
<text wx:if="{{history}}" class="caption">吃粮记录会保存到云端。可补录吃过的粮和日期；日期不完整时不推断同期问题。</text>
<view wx:if="{{loading}}" class="empty-state">正在读取…</view><view wx:elif="{{error}}" class="empty-state">{{error}}<button class="text-button" bindtap="load">重试</button></view>
<block wx:else><view wx:if="{{!items.length}}" class="empty-state">{{history ? '还没有历史口粮，可以补录吃过的粮。' : '还没有口粮，点击底部按钮添加。'}}</view><view wx:for="{{items}}" wx:key="id" class="diet-list-card"><view class="diet-icon"><p-icon name="food" /></view><view class="diet-copy"><text class="diet-name">{{item.brand}} · {{item.product}}</text><text class="caption">{{item.periodText}}</text><text wx:if="{{history}}" class="caption">{{item.healthText || (item.association_available ? '同期暂无相关咨询记录' : '日期信息不足，暂不关联咨询')}}</text><text wx:if="{{item.association_truncated}}" class="caption">以上按最近1000条对话消息汇总。</text><text wx:if="{{item.note}}" class="caption">{{item.note}}</text></view><button wx:if="{{history}}" class="text-button" data-id="{{item.id}}" bindtap="removeHistory" disabled="{{saving}}">删除</button><button wx:if="{{!history}}" class="text-button" bindtap="edit" aria-label="编辑口粮"><p-icon name="edit" size="30" /></button></view></block><view wx:if="{{history && legacyItems.length}}"><text class="section-title">本机旧记录</text><text class="caption">确认后可保存到云端。旧记录的变更日期不作为实际吃粮日期。</text><view wx:for="{{legacyItems}}" wx:key="id" class="diet-list-card"><view class="diet-copy"><text class="diet-name">{{item.brand}} · {{item.product}}</text></view><button class="text-button" data-id="{{item.id}}" bindtap="importLegacy" disabled="{{saving}}">确认并保存</button></view></view><text wx:if="{{history && items.length}}" class="caption">{{associationNote}}</text><text wx:if="{{hasMore}}" class="caption">当前显示最近100条吃粮记录。</text>
</view></view>
<view wx:if="{{!editing && pet && !error}}" class="page-action-footer"><button class="primary-button" bindtap="edit" disabled="{{loading}}">{{history ? '补录历史口粮' : items.length ? '更换口粮' : '添加口粮'}}</button></view>
<view wx:if="{{editing}}" class="sheet-mask" bindtap="close"></view><view wx:if="{{editing}}" class="bottom-sheet"><view class="sheet-heading"><text>{{pet.name}}的口粮</text><button bindtap="close" disabled="{{saving}}"><p-icon name="close" /></button></view><view class="form-field"><text>品牌</text><input value="{{form.brand}}" data-key="brand" bindinput="input" maxlength="128" disabled="{{saving}}" placeholder="如：皇家" /></view><view class="form-field"><text>系列</text><input value="{{form.product}}" data-key="product" bindinput="input" maxlength="512" disabled="{{saving}}" placeholder="如：FIT32" /></view><block wx:if="{{history}}"><view class="form-field"><text>开始日期（选填）</text><picker mode="date" end="{{today}}" value="{{form.started_on}}" data-key="started_on" bindchange="dateChange" disabled="{{saving}}"><view class="form-value">{{form.started_on || '不确定可留空'}}</view></picker></view><view class="form-field"><text>结束日期（选填）</text><picker mode="date" end="{{today}}" value="{{form.ended_on}}" data-key="ended_on" bindchange="dateChange" disabled="{{saving}}"><view class="form-value">{{form.ended_on || '不确定可留空'}}</view></picker></view><view class="form-field"><text>吃粮表现（选填）</text><input value="{{form.note}}" data-key="note" bindinput="input" maxlength="1000" disabled="{{saving}}" placeholder="如：吃得适应、曾出现软便" /></view></block><text wx:else class="caption">保存表示确认当前正在吃这款粮；选粮计划请先与管家讨论。</text><button class="primary-button" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存口粮</button></view>
