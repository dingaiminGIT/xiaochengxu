<view class="page post-detail-page">
<page-header title="帖子详情" back />
<view wx:if="{{post && !loading}}" class="author-row">
<p-image wx:if="{{post.avatar}}" image-class="author-avatar" src="{{post.avatar}}" />
<view wx:else class="author-avatar avatar-placeholder">
<p-icon name="cat" size="36" />
</view>
<view class="author-copy">
<text class="author-name">{{post.author}}</text>

</view>
<button wx:if="{{isOwner}}" class="text-button post-manage" bindtap="deletePost" loading="{{deleting}}" disabled="{{deleting}}">删除</button>
<button wx:else class="icon-action" bindtap="openReport" aria-label="举报帖子"><p-icon name="report" tone="muted" size="36" /></button>
</view>
<scroll-view class="post-scroll" scroll-y scroll-with-animation scroll-into-view="{{commentAnchor}}"><view class="screen-body">
<view wx:if="{{loading}}" class="empty-state">正在读取这篇记录…</view>
<view wx:elif="{{error}}" class="empty-state">
<p-icon name="post" tone="muted" size="64" />
<text class="empty-title">暂时无法查看</text>
<text>{{error}}</text>
<button class="text-button" bindtap="loadPost">重新加载</button>
</view>
<block wx:elif="{{post}}">
<view wx:if="{{post.images.length}}" class="post-gallery">
  <swiper class="photo-swiper" current="{{photoIndex}}" bindchange="onPhotoChange" indicator-dots="{{false}}" autoplay="{{false}}">
    <swiper-item wx:for="{{post.images}}" wx:key="*this">
      <view class="photo-item" data-index="{{index}}" bindtap="previewImage" aria-label="查看第{{index + 1}}张大图">
        <p-image image-class="post-photo" src="{{item}}" mode="aspectFit" />
      </view>
    </swiper-item>
  </swiper>
  <view wx:if="{{post.images.length > 1}}" class="photo-dots" aria-label="第{{photoIndex + 1}}张，共{{post.images.length}}张">
    <view wx:for="{{post.images}}" wx:key="*this" class="photo-dot {{photoIndex === index ? 'active' : ''}}"></view>
  </view>
</view>
<view class="post-copy">
  <text class="post-title" selectable>{{post.title}}</text>
  <text wx:if="{{post.displayBody}}" class="post-body" selectable>{{post.displayBody}}</text>
</view>
<view class="post-meta"><text>{{post.editedText}}编辑</text><text wx:if="{{post.tag}}" class="tag">{{post.tag}}</text></view>
<view id="post-comments" class="post-comments">
 <text class="comments-title">共 {{post.commentCount || 0}} 条评论</text>
 <button class="inline-comment-entry" bindtap="openComments"><p-icon name="edit" tone="muted" size="30" /><text>分享你的想法…</text></button>

  <view wx:if="{{commentsLoading}}" class="comments-empty">正在加载评论…</view>
  <view wx:elif="{{commentsError}}" class="comments-empty">{{commentsError}}<button class="text-button" bindtap="loadComments">重试</button></view>
  <view wx:elif="{{!comments.length}}" class="comments-empty">还没有评论，聊聊你的经验吧</view>
  <view wx:for="{{comments}}" wx:key="id" class="comment-row"><p-image wx:if="{{item.avatar}}" image-class="comment-avatar" src="{{item.avatar}}" /><view wx:else class="comment-avatar comment-placeholder"><p-icon name="cat" size="28" /></view><view class="comment-copy"><text class="comment-author">{{item.author}}</text><text class="comment-content" selectable>{{item.content}}</text><view class="comment-meta"><text>{{item.date}}</text><button wx:if="{{viewerId && item.user_id === viewerId}}" class="text-button" data-id="{{item.id}}" bindtap="deleteComment" disabled="{{commentDeleting || commentSending}}">删除</button></view></view></view>
  <text wx:if="{{comments.length >= 100}}" class="caption">当前展示前 100 条评论</text>
</view>
</block>
</view></scroll-view>
<view wx:if="{{post && !loading && !reportVisible && !commentsVisible}}" class="detail-actions">
<button class="text-button" open-type="share" aria-label="分享给朋友">分享</button><button class="comment-entry" bindtap="openComments"><p-icon name="edit" tone="muted" size="32" /><text>说点什么…</text></button>
<button class="icon-action social-action" bindtap="toggleLike" disabled="{{liking}}" aria-label="{{post.liked ? '取消点赞' : '点赞'}}"><p-icon name="{{post.liked ? 'heart-filled' : 'heart'}}" tone="{{post.liked ? 'primary' : 'muted'}}" size="40" /><text wx:if="{{post.likes}}">{{post.likes}}</text></button>

<button class="icon-action" bindtap="toggleSave" aria-label="{{saved ? '取消收藏' : '收藏帖子'}}">
<p-icon name="{{saved ? 'saved' : 'save'}}" tone="{{saved ? 'primary' : 'muted'}}" size="40" />
</button>
<button class="icon-action social-action" bindtap="scrollToComments" aria-label="查看评论"><p-icon name="chat" tone="muted" size="40" /><text wx:if="{{post.commentCount}}">{{post.commentCount}}</text></button>
</view>
</view>

<view wx:if="{{reportVisible}}" class="sheet-mask" bindtap="closeReport">
</view>
<view wx:if="{{reportVisible}}" class="bottom-sheet report-sheet">
  <view class="sheet-heading">
<text>举报帖子</text>
<button bindtap="closeReport" disabled="{{reporting}}" aria-label="关闭">
<p-icon name="close" />
</button>
</view>
  <view wx:if="{{reasonsLoading}}" class="caption">正在获取举报原因…</view>
  <view wx:if="{{reportError}}" class="caption">{{reportError}}<button wx:if="{{!reasons.length}}" class="text-button" bindtap="openReport">重试</button>
</view>
  <view class="report-reasons">
<button wx:for="{{reasons}}" wx:key="code" size="mini" class="report-reason {{reason === item.code ? 'active' : ''}}" data-code="{{item.code}}" bindtap="chooseReason" disabled="{{reporting}}">{{item.label}}</button>
</view>
  <textarea class="report-detail" value="{{detail}}" bindinput="inputReport" maxlength="1000" placeholder="补充说明（选填）" disabled="{{reporting}}" />
  <button class="primary-button" bindtap="submitReport" loading="{{reporting}}" disabled="{{reporting || reasonsLoading || !reason}}">提交举报</button>
</view>

<view wx:if="{{commentsVisible}}" class="sheet-mask" bindtap="closeComments"></view>
<view wx:if="{{commentsVisible}}" class="bottom-sheet comments-sheet">
 <view class="sheet-heading"><text>发表评论</text><button bindtap="closeComments" disabled="{{commentSending || commentDeleting}}" aria-label="关闭评论"><p-icon name="close" /></button></view>

 <view class="comment-composer"><textarea value="{{commentDraft}}" bindinput="inputComment" maxlength="500" focus="{{commentsVisible}}" placeholder="分享你的想法…" disabled="{{commentSending}}" cursor-spacing="24" /><button class="comment-send" bindtap="sendComment" loading="{{commentSending}}" disabled="{{commentSending || commentDeleting || commentsLoading || !commentDraft}}">发送</button></view>
</view>
