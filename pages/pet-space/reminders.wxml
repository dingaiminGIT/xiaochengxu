<template name="reminder-card"><view class="reminder-card"><button class="reminder-card-title" bindtap="edit" data-id="{{item.id}}"><view class="reminder-icon"><p-icon name="{{item.icon}}" size="38" /></view><text>{{item.title}}</text><text wx:if="{{!item.cloud}}" class="caption">本机旧提醒</text><p-icon name="arrow" size="24" tone="muted" /></button><view class="reminder-line"><text class="caption">时间</text><text class="{{item.overdue ? 'overdue-text' : ''}}">{{item.dueText}}</text><text wx:if="{{item.overdue}}" class="overdue-tag">{{item.overdueText}}</text></view><view class="reminder-line"><text class="caption">重复</text><text>{{item.repeatText}}</text></view><view class="reminder-card-bottom"><text class="pet-label">{{item.petName || '未关联宠物'}}</text><button wx:if="{{!item.occurrence}}" size="mini" class="complete-button" bindtap="complete" data-id="{{item.id}}" data-due="{{item.dueAt}}"><p-icon name="check" size="24" />标记完成</button></view></view></template>
<view class="page reminders-page"><page-header title="{{history ? '历史记录' : '我的提醒'}}" back /><view class="screen-body">
<view class="reminder-notice">提醒会保存到账号，可在其他设备查看。当前只在小程序内展示，不发送系统推送。</view>
<view wx:if="{{syncError}}" class="reminder-notice"><text>{{syncError}}</text><button class="text-button" bindtap="sync">重试同步</button></view>
<view wx:if="{{legacyCount}}" class="reminder-notice"><text>本机还有 {{legacyCount}} 条旧提醒，核对后可同步到账号。</text><button class="text-button" bindtap="importLegacy">同步旧提醒</button></view>
<block wx:if="{{!history}}">
<view class="reminder-calendar">
 <view class="calendar-toolbar"><text>{{calendarMonth}}</text><view class="calendar-controls"><button class="text-button" data-days="-14" bindtap="moveCalendar" aria-label="前两周"><p-icon name="back" size="26" /></button><button class="text-button" data-days="14" bindtap="moveCalendar" aria-label="后两周"><p-icon name="arrow" size="26" /></button></view></view>
 <view class="calendar-weekdays"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
 <view class="calendar-fortnight" bindtouchstart="calendarTouchStart" bindtouchend="calendarTouchEnd"><button wx:for="{{calendarDays}}" wx:key="key" class="calendar-day {{item.selected ? 'selected' : ''}} {{item.today ? 'today' : ''}}" data-date="{{item.key}}" bindtap="chooseDate"><text class="calendar-number">{{item.day}}</text><view class="calendar-dot {{item.count ? 'has-reminder' : ''}}"></view></button></view>
</view>
<view class="section-heading reminder-section-heading"><text>新增提醒</text><text>选择一件照顾它的小事</text></view>
<view class="compact-reminder-types"><button wx:for="{{types}}" wx:key="id" bindtap="createType" data-id="{{item.id}}"><p-icon name="{{item.icon}}" size="30" /><text>{{item.name}}</text></button></view>
<view class="reminder-list-heading"><button class="text-button {{showAll ? 'selected-filter' : ''}}" bindtap="allDates">全部提醒</button><text wx:if="{{!showAll}}" class="caption">{{calendarDate}}</text><button class="text-button" bindtap="history"><p-icon name="history" size="24" />历史</button></view>
<view wx:if="{{!overdue.length && !upcoming.length}}" class="calendar-empty">{{showAll ? '还没有提醒，选择上方类型添加' : '这一天没有提醒'}}</view>
<view wx:if="{{overdue.length}}" class="reminder-group-label">逾期提醒</view><template wx:for="{{overdue}}" wx:key="id" is="reminder-card" data="{{item}}" />
<view wx:if="{{upcoming.length}}" class="reminder-group-label">待办提醒</view><template wx:for="{{upcoming}}" wx:key="id" is="reminder-card" data="{{item}}" />

</block>
<block wx:else><scroll-view scroll-x class="reminder-filter-scroll"><view class="reminder-filters"><button wx:for="{{filters}}" wx:key="id" size="mini" class="filter-chip {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseFilter">{{item.name}}</button></view></scroll-view><view wx:if="{{!records.length}}" class="empty-state">完成提醒后，记录会出现在这里</view><button wx:for="{{records}}" wx:key="id" class="history-row" bindtap="detail" data-id="{{item.id}}"><view class="history-copy"><text class="reminder-name">{{item.title}}</text><text>{{item.completedText}}</text><text class="caption">{{item.petName || '未关联宠物'}}</text></view><text class="caption">已完成</text><p-icon name="arrow" size="24" tone="muted" /></button></block>
</view></view>
<view wx:if="{{selected}}" class="sheet-mask" bindtap="close"></view><view wx:if="{{selected}}" class="bottom-sheet"><view class="sheet-heading"><text>{{selected.title}}</text><button bindtap="close" aria-label="关闭"><p-icon name="close" /></button></view><view class="reminder-line">计划时间：{{selected.dueText}}</view><view class="reminder-line">完成时间：{{selected.completedText}}</view><view class="reminder-line">关联宠物：{{selected.petName || '无'}}</view><text class="reminder-note">{{selected.note || '没有备注'}}</text></view>
