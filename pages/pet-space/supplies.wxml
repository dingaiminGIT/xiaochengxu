<view class="page {{kind === 'food' ? 'food-page' : ''}} {{!hasPet ? 'needs-pet' : ''}}">
  <page-header title="{{title}}" back />
  <view class="screen-body">
    <swiper
      class="hero-swiper"
      current="{{slide}}"
      bindchange="changeSlide"
      circular
      indicator-dots
      indicator-color="rgba(255,255,255,.4)"
      indicator-active-color="#ffffff"
    >
      <swiper-item wx:for="{{slides}}" wx:key="id">
        <view class="hero-slide">
          <p-image image-class="hero-image" src="{{item.image}}" mode="aspectFill" />
          <view class="hero-shade"></view>
          <view class="hero-copy">
            <text class="hero-kicker">{{kind === 'toys' ? 'PLAY & LOVE' : 'EAT & LOVE'}}</text>
            <text class="hero-title">{{item.title}}</text>
            <text class="hero-subtitle">{{item.subtitle}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="section-heading">
      <view class="list-title-row"><text class="list-title">{{kind === 'food' && selectedPetName ? selectedPetName + '的清单' : '我的清单'}} <text wx:if="{{kind === 'toys' && mine.length > 0}}" class="count">{{mine.length}}</text></text><button wx:if="{{kind === 'food' && pets.length > 1}}" class="list-pet-switch" size="mini" bindtap="openListPetPicker" aria-label="切换宠物"><p-icon name="switch" size="26" /></button></view>
      <button wx:if="{{kind === 'food'}}" class="text-button" bindtap="openFoodList">更多<p-icon name="arrow" size="24" /></button><button wx:else class="text-button" bindtap="editMine"><p-icon name="plus" size="26" />添加</button>
    </view>
    <view class="section-content">
    <view wx:if="{{mineLoading && !mine.length}}" class="local-empty">正在读取宠物口粮…</view>
    <view wx:if="{{mineError}}" class="local-empty">{{mineError}}<button class="text-button" bindtap="refreshMine">重新加载</button></view>
    <view wx:if="{{!mineLoading && !mineError && !mine.length}}" class="local-empty">
      {{kind === 'toys' ? '它喜欢的玩具，在这里慢慢收集。' : '还没有口粮记录，点击添加，为爱宠记录正在吃的粮。'}}
    </view>
    <scroll-view wx:if="{{kind === 'food'}}" scroll-x class="diet-mine-scroll"><view class="diet-mine-row">

      <button wx:for="{{mine}}" wx:key="id" class="food-mine-card" data-id="{{item.id}}" bindtap="editMine">
        <p-image wx:if="{{item.image}}" image-class="food-mine-photo" src="{{item.image}}" />
        <view wx:else class="food-mine-placeholder"><p-icon name="food" size="44" /></view>
        <view class="food-current-check"><p-icon name="check" tone="inverse" size="22" /></view><text class="food-mine-name">{{item.name}}</text><text class="food-mine-status">{{item.note}}</text>
      </button>
      <view class="food-mine-card food-mine-entry"><button class="entry-add" bindtap="openHunting" disabled="{{mineLoading || mineError}}" aria-label="添加口粮"><p-icon name="plus" size="52" /></button></view>
    </view></scroll-view>
    <block wx:else>    <button wx:for="{{mine}}" wx:key="id" class="mine-card" data-id="{{item.id}}" bindtap="editMine">
      <p-image wx:if="{{kind === 'food' && item.image}}" image-class="mine-photo" src="{{item.image}}" /><view wx:else class="mine-icon"><p-icon name="{{kind === 'toys' ? 'toy' : 'food'}}" /></view>
      <view class="mine-copy">
        <text class="card-title">{{item.name}}</text>
        <text class="card-note">{{item.note || '轻点补充使用记录'}}</text>
      </view>
      <p-icon name="arrow" size="26" tone="muted" />
    </button>
</block>
    <text wx:if="{{kind === 'toys'}}" class="caption">清单保存在当前设备</text>

    </view>
    <view class="section-heading">
      <text>{{kind === 'toys' ? '创意好物' : '狩猎广场'}}</text>
<text wx:if="{{kind === 'toys'}}">来自周边创意</text><button wx:else class="text-button" bindtap="openHunting">更多<p-icon name="arrow" size="24" /></button>
    </view>

    <view class="section-content">
    <view wx:if="{{loading}}" class="empty-state">正在加载{{kind === 'toys' ? '创意好物' : '狩猎广场'}}…</view>
    <view wx:if="{{error}}" class="empty-state">
      {{error}}
      <button class="text-button" bindtap="loadCatalog">重新加载</button>
    </view>

    <view class="catalog-grid">
      <button wx:for="{{items}}" wx:key="id" class="catalog-card" data-id="{{item.id}}" bindtap="openItem">
        <view class="catalog-media">
          <p-image wx:if="{{item.image}}" image-class="catalog-image" src="{{item.image}}" mode="aspectFill" />
          <view wx:else class="catalog-placeholder {{kind}}">
            <p-icon
              name="{{kind === 'toys' ? 'toy' : 'food'}}"
              size="80"
              tone="{{kind === 'food' ? 'accentText' : 'primary'}}"
            />
          </view>
          <text wx:if="{{kind === 'food' && item.brand}}" class="catalog-brand">{{item.brand}}</text>
        </view>
        <view class="catalog-copy">
          <text wx:if="{{kind === 'toys'}}" class="card-tag">{{item.tag}}</text>
          <text class="card-title">{{item.name}}</text>
          <text class="card-note">{{kind === 'food' ? item.displayText : item.note}}</text>
        </view>
      </button>
    </view>

    <view wx:if="{{!loading && !error && !items.length}}" class="empty-state catalog-empty">
      <text>
        {{kind === 'toys' ? '更多创意正在准备中，也可以先添加自己的玩具。' : '暂未收录相关商品，试试其他品牌或手动添加'}}
      </text>
      <button wx:if="{{kind === 'food'}}" class="catalog-empty-button" bindtap="openCatalogAdd">手动添加</button>
    </view>
    </view>
  </view>
</view>

<view wx:if="{{!hasPet && !selected && !editing && !catalogAdding}}" class="page-action-footer">
  <button class="primary-button" bindtap="addPet"><p-icon name="plus" tone="inverse" size="30" />添加爱宠</button>
</view>

<view
  wx:if="{{selected || editing || catalogAdding}}"
  class="sheet-mask"
  bindtap="{{catalogAdding ? 'closeCatalogAdd' : editing ? 'closeEditor' : 'closeDetail'}}"
></view>

<view wx:if="{{selected}}" class="bottom-sheet">
  <view class="sheet-heading">
    <text>{{kind === 'food' ? '食品详情' : '好物详情'}}</text>
    <button bindtap="closeDetail" aria-label="关闭"><p-icon name="close" /></button>
  </view>
  <p-image wx:if="{{selected.image}}" image-class="detail-image" src="{{selected.image}}" mode="widthFix" />
  <view wx:else class="detail-placeholder {{kind}}">
    <p-icon name="{{kind === 'toys' ? 'toy' : 'food'}}" size="96" tone="{{kind === 'food' ? 'accentText' : 'primary'}}" />
  </view>
  <text wx:if="{{selected.brand || selected.tag}}" class="tag">{{selected.brand || selected.tag}}</text>
  <view class="section-heading detail-title">{{selected.name}}</view>
  <text wx:if="{{kind === 'food' && selected.originType}}" class="detail-meta">{{selected.originType}}</text>
  <text class="detail-note">{{kind === 'food' ? selected.displayText : selected.note}}</text>
  <button class="primary-button" bindtap="addToMine">{{kind === 'food' ? '设为当前口粮' : '加入我的玩具'}}</button>
</view>

<view wx:if="{{catalogAdding}}" class="bottom-sheet">
  <block wx:if="{{catalogEditorMode === 'ingredient'}}">
    <view class="sheet-heading">
      <text>拍摄示例</text>
      <button bindtap="closeCatalogIngredient" aria-label="返回"><p-icon name="close" /></button>
    </view>
    <view class="ingredient-sheet">
      <view class="ingredient-sample" bindtap="previewIngredientExample">
        <image
          class="ingredient-sample-image"
          src="/pages/pet-space/static/ingredient-example.jpg"
          mode="aspectFill"
        />
        <text class="ingredient-sample-tip">
          必须同时包含完整配料表和营养成分保证值；若在不同包装面，请分别拍摄并一起上传。
        </text>
      </view>
      <text class="ingredient-format-hint">支持 1~3 张 JPG、PNG、WEBP，单张不超过 10MB</text>
      <button class="ingredient-found-button" bindtap="onCatalogIngredientFound">选择或拍照</button>
    </view>
  </block>
  <block wx:else>
    <view class="sheet-heading">
      <text>新增食品</text>
      <button bindtap="closeCatalogAdd" aria-label="关闭"><p-icon name="close" /></button>
    </view>
    <view class="form-field">
      <text>品牌</text>
      <input value="{{catalogForm.brand}}" data-key="brand" bindinput="inputCatalog" maxlength="40" placeholder="如皇家、渴望" />
    </view>
    <view class="form-field">
      <text>系列</text>
      <input
        value="{{catalogForm.series}}"
        data-key="series"
        bindinput="inputCatalog"
        maxlength="60"
        placeholder="如 BK34、肠道舒适"
      />
    </view>
    <view class="ingredient-entry" bindtap="openCatalogIngredient">
      <view class="ingredient-entry-icon"><p-icon name="image" size="36" /></view>
      <view class="ingredient-entry-copy">
        <text class="ingredient-entry-title">上传图片分析配方</text>
        <text class="caption">上传包装照片，识别配料与营养信息</text>
      </view>
      <text class="ingredient-entry-arrow">↗</text>
    </view>
    <view wx:if="{{catalogForm.images.length}}" class="form-images">
      <view
        wx:for="{{catalogForm.images}}"
        wx:key="*this"
        class="form-image"
        data-current="{{item}}"
        bindtap="previewCatalogImage"
      >
        <image src="{{item}}" mode="aspectFill" />
        <button class="form-image-remove" data-index="{{index}}" catchtap="removeCatalogImage" aria-label="移除图片">
          <p-icon name="close" tone="inverse" size="20" />
        </button>
      </view>
    </view>
    <button class="primary-button" bindtap="saveCatalogFood">保存到食品目录</button>
  </block>
</view>

<view wx:if="{{editing && kind === 'food'}}" class="bottom-sheet">
  <view class="sheet-heading"><text>记录当前口粮</text><button bindtap="closeEditor" disabled="{{dietSaving}}" aria-label="关闭"><p-icon name="close" /></button></view>
  <scroll-view scroll-x class="diet-pet-scroll"><view class="diet-pet-row"><button wx:for="{{pets}}" wx:key="id" class="diet-pet {{dietPetId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectDietPet" disabled="{{dietSaving}}">{{item.name}}</button></view></scroll-view>
  <text class="caption">每只宠物记录一份当前口粮，保存后将替换该宠物原来的口粮。</text>
  <view class="form-field"><text>品牌</text><input value="{{dietForm.brand}}" data-key="brand" bindinput="inputDiet" maxlength="128" placeholder="如：皇家" disabled="{{dietSaving}}" /></view>
  <view class="form-field"><text>产品 / 系列</text><input value="{{dietForm.product}}" data-key="product" bindinput="inputDiet" maxlength="512" placeholder="如：肠胃舒适" disabled="{{dietSaving}}" /></view>
  <button class="primary-button" bindtap="saveMine" loading="{{dietSaving}}" disabled="{{dietSaving}}">保存口粮</button>
</view>
<view wx:if="{{editing && kind === 'toys'}}" class="bottom-sheet">
  <block wx:if="{{editorMode === 'ingredient'}}">
    <view class="sheet-heading">
      <text>拍摄示例</text>
      <button bindtap="closeIngredientSheet" aria-label="返回"><p-icon name="close" /></button>
    </view>
    <view class="ingredient-sheet">
      <view class="ingredient-sample" bindtap="previewIngredientExample">
        <image
          class="ingredient-sample-image"
          src="/pages/pet-space/static/ingredient-example.jpg"
          mode="aspectFill"
        />
        <text class="ingredient-sample-tip">
          必须同时包含完整配料表和营养成分保证值；若在不同包装面，请分别拍摄并一起上传。
        </text>
      </view>
      <text class="ingredient-format-hint">支持 1~3 张 JPG、PNG、WEBP，单张不超过 10MB</text>
      <button class="ingredient-found-button" bindtap="onIngredientFound">选择或拍照</button>
    </view>
  </block>
  <block wx:else>
    <view class="sheet-heading">
      <text>{{editingId ? '编辑记录' : '添加记录'}}</text>
      <button bindtap="closeEditor" aria-label="关闭"><p-icon name="close" /></button>
    </view>
    <view wx:if="{{kind === 'food'}}" class="ingredient-entry" bindtap="openIngredientSheet">
      <view class="ingredient-entry-icon"><p-icon name="image" size="36" /></view>
      <view class="ingredient-entry-copy">
        <text class="ingredient-entry-title">分析配料表</text>
        <text class="caption">拍照或上传配料表，辅助添加食物记录</text>
      </view>
      <text class="ingredient-entry-arrow">↗</text>
    </view>
    <view wx:if="{{kind === 'food' && form.images.length}}" class="form-images">
      <view
        wx:for="{{form.images}}"
        wx:key="*this"
        class="form-image"
        data-current="{{item}}"
        bindtap="previewFormImage"
      >
        <image src="{{item}}" mode="aspectFill" />
        <button class="form-image-remove" data-index="{{index}}" catchtap="removeFormImage" aria-label="移除图片">
          <p-icon name="close" tone="inverse" size="20" />
        </button>
      </view>
    </view>
    <view class="form-field">
      <text>名称</text>
      <input
        value="{{form.name}}"
        data-key="name"
        bindinput="input"
        maxlength="100"
        placeholder="{{kind === 'food' ? '填写食品名称' : '填写玩具或食品名称'}}"
      />
    </view>
    <view class="form-field">
      <text>使用记录</text>
      <textarea
        value="{{form.note}}"
        data-key="note"
        bindinput="input"
        maxlength="300"
        placeholder="记录它的喜好、口味或使用感受…"
      />
    </view>
    <button class="primary-button" bindtap="saveMine">保存记录</button>
  </block>
</view>

<view wx:if="{{listPetPickerVisible}}" class="sheet-mask" bindtap="closeListPetPicker"></view>
<view wx:if="{{listPetPickerVisible}}" class="bottom-sheet">
  <view class="sheet-heading"><text>选择宠物</text><button bindtap="closeListPetPicker" aria-label="关闭"><p-icon name="close" /></button></view>
  <view class="list-pet-options"><button wx:for="{{pets}}" wx:key="id" class="list-pet-option {{selectedPetId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectListPet">
    <p-image wx:if="{{item.image}}" image-class="list-pet-avatar" src="{{item.image}}" />
    <view wx:else class="list-pet-avatar list-pet-placeholder"><p-icon name="{{item.type === '狗狗' ? 'dog' : 'cat'}}" size="36" /></view>
    <text class="list-pet-name">{{item.name}}</text><p-icon wx:if="{{selectedPetId === item.id}}" name="check" size="28" />
  </button></view>
</view>
