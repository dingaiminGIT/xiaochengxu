<view class="page has-page-actions">
  <page-header title="{{creating ? '添加食物' : selected ? '投稿详情' : '我的投稿'}}" back custom-back bind:back="back" />
  <view class="screen-body">
    <view wx:if="{{error && !creating}}" class="notice">{{error}}<button wx:if="{{signedOut}}" class="text-button" bindtap="signIn">登录后查看</button><button wx:else class="text-button" bindtap="load">重试</button></view>
    <block wx:if="{{creating}}">
      <view class="form-card">
        <view id="field-brand" class="form-field {{invalid.brand ? 'field-invalid' : ''}}">
          <text>品牌 *</text>
          <input value="{{form.brand}}" data-key="brand" bindinput="input" maxlength="255" disabled="{{saving}}" placeholder="请输入品牌" placeholder-class="input-placeholder" aria-label="品牌，必填" />
        </view>
        <view id="field-product" class="form-field {{invalid.product ? 'field-invalid' : ''}}">
          <text>系列 / 产品名称 *</text>
          <input value="{{form.product}}" data-key="product" bindinput="input" maxlength="512" disabled="{{saving}}" placeholder="请输入系列 / 产品名称" placeholder-class="input-placeholder" aria-label="系列或产品名称，必填" />
        </view>
      </view>
      <view id="field-images" class="form-card {{invalid.images ? 'photos-invalid' : ''}}">
        <view class="photo-heading"><text class="section-title">包装照片 *</text><button class="text-button" bindtap="previewIngredientExample">拍摄示例 ›</button></view>
        <text class="caption">配料表必拍，营养成分表选拍</text>
        <view class="photos">
          <view wx:for="{{form.images}}" wx:key="*this" class="photo-wrap">
            <p-image image-class="photo" src="{{item}}" data-url="{{item}}" bindtap="preview" />
            <button class="remove-photo" data-index="{{index}}" bindtap="removeImage" disabled="{{saving}}" aria-label="删除第{{index + 1}}张照片">删除</button>
          </view>
          <button wx:if="{{form.images.length < 3}}" class="add-photo" bindtap="chooseImages" disabled="{{saving}}"><p-icon name="plus" tone="primary" size="44" /><text>添加照片</text></button>
        </view>
        <text class="caption">已上传 {{form.images.length}}/3 张 · 单张不超过 10MB</text>
      </view>
      <view class="form-card">
        <view class="form-field remark-field"><text>备注（选填）</text><textarea value="{{form.remark}}" data-key="remark" bindinput="input" maxlength="1000" disabled="{{saving}}" placeholder="补充包装信息…" placeholder-class="input-placeholder" /></view>
      </view>
    </block>
    <block wx:elif="{{selected}}">
      <view class="form-card">
        <text class="section-title">{{selected.title}}</text>
        <text wx:if="{{selected.created_at}}" class="caption">提交时间 {{selected.created_at}}</text>
        <view class="photos"><p-image wx:for="{{selected.images}}" wx:key="id" image-class="photo" src="{{item.url}}" data-url="{{item.url}}" bindtap="preview" /></view>
        <text wx:if="{{selected.remark}}" class="body-copy">{{selected.remark}}</text>
      </view>
      <view class="form-card result-progress" aria-live="polite">
        <text class="section-title">{{selected.resultReady ? selected.resultLabel : selected.statusText}}</text>
        <text class="body-copy">{{selected.recognitionMessage}}</text>
        <text wx:if="{{selected.isProcessing && selected.processing_stage}}" class="caption">{{selected.processing_stage}}</text>
        <text wx:if="{{selected.resultNote}}" class="caption">{{selected.resultNote}}</text>
        <view wx:if="{{selected.partialResult}}">
          <text class="caption">已读取以下营养保证值；配方画像和风险结果尚未就绪。</text>
          <view wx:for="{{selected.nutritionRows}}" wx:key="name" class="result-dimension"><text>{{item.name}}</text><text>{{item.display}}</text></view>
        </view>
        <view wx:if="{{selected.resultReady}}" class="result-dimensions">
          <view wx:for="{{selected.dimensions}}" wx:key="key" class="result-dimension">
            <text>{{item.name || item.label || item.key}}</text><text>{{item.scoreText}}</text>
          </view>
        </view>
        <text wx:if="{{selected.resultReady}}" class="caption">各维度含义不同，分数不代表综合优劣。</text>
        <button wx:if="{{selected.resultReady}}" class="text-button" bindtap="analyzeResult">交给管家，与当前口粮对比 ›</button>
        <button class="text-button" bindtap="load">刷新结果</button>
      </view>
      <view wx:if="{{selected.ingredient_composition || selected.guaranteeText}}" class="form-card">
        <block wx:if="{{selected.ingredient_composition}}"><text class="section-title">配料表</text><text class="body-copy">{{selected.ingredient_composition}}</text></block>
        <block wx:if="{{selected.guaranteeText}}"><text class="section-title">营养成分</text><text class="body-copy">{{selected.guaranteeText}}</text></block>
      </view>
    </block>
    <block wx:else>
      <view wx:if="{{loading && !items.length}}" class="empty-state">正在加载…</view>
      <view wx:if="{{!loading && !error && !items.length}}" class="empty-state">还没有投稿</view>
      <button wx:for="{{items}}" wx:key="id" class="submission" data-id="{{item.id}}" bindtap="open"><text class="section-title">{{item.title}}</text><text class="caption">提交时间 {{item.created_at}}</text><text class="caption">{{item.statusText}}</text><text class="submission-link">查看结果与投稿内容 ›</text></button>
    </block>
  </view>
</view>
<view class="page-action-footer submission-footer">
  <button wx:if="{{creating}}" class="primary-button" bindtap="submit" loading="{{saving}}" disabled="{{saving}}">{{saving ? '提交中' : '提交投稿'}}</button>
  <button wx:elif="{{selected}}" class="primary-button" bindtap="closeDetail">返回列表</button>
  <button wx:else class="primary-button" bindtap="create">＋ 添加食物</button>
</view>
