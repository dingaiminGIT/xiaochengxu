<view class="page has-page-actions"><page-header title="{{id ? '编辑提醒' : '添加提醒'}}" back /><view class="screen-body"><view wx:if="{{missing}}" class="empty-state">这条提醒已不存在，请返回查看</view><block wx:else><view class="reminder-title-card"><view class="type-icon"><p-icon name="{{icon}}" size="44" /></view><input value="{{title}}" maxlength="40" data-key="title" bindinput="input" placeholder="给提醒起个名字" /></view><view class="section-heading">基本信息</view><view class="reminder-form-card"><picker range="{{repeatLabels}}" value="{{repeatIndex}}" bindchange="repeat"><view class="reminder-form-row"><text>重复提醒</text><text class="form-choice filled">{{repeatLabels[repeatIndex]}}</text><p-icon name="arrow" size="24" tone="muted" /></view></picker><picker wx:if="{{repeatId !== 'daily' && repeatId !== 'weekly'}}" mode="date" value="{{date || today}}" bindchange="input" data-key="date"><view class="reminder-form-row"><text>{{repeatId === 'none' ? '提醒日期' : '首次提醒日期'}}</text><text class="form-choice {{date ? 'filled' : ''}}">{{date || '选择日期'}}</text><p-icon name="arrow" size="24" tone="muted" /></view></picker><picker wx:if="{{repeatId === 'weekly'}}" range="{{weekdayLabels}}" value="{{weekdayIndex >= 0 ? weekdayIndex : 0}}" bindchange="weekday"><view class="reminder-form-row"><text>提醒星期</text><text class="form-choice {{weekdayIndex >= 0 ? 'filled' : ''}}">{{weekdayIndex >= 0 ? weekdayLabels[weekdayIndex] : '选择星期'}}</text><p-icon name="arrow" size="24" tone="muted" /></view></picker><picker mode="time" value="{{time || '09:00'}}" bindchange="input" data-key="time"><view class="reminder-form-row"><text>提醒时间</text><text class="form-choice {{time ? 'filled' : ''}}">{{time || '选择时间'}}</text><p-icon name="arrow" size="24" tone="muted" /></view></picker><button class="reminder-form-row" bindtap="choosePet"><text>关联宠物</text><text class="form-choice filled">{{petName || '无'}}</text><p-icon name="arrow" size="24" tone="muted" /></button></view><text wx:if="{{repeatIndex > 0}}" class="caption local-note">标记完成后生成下一次提醒，已错过的周期自动跳过。</text><view class="section-heading">备注</view><textarea class="reminder-note-input" value="{{note}}" data-key="note" bindinput="input" maxlength="500" placeholder="有需要的话，备注一下吧～" /><text class="caption local-note">提醒保存到云端，暂不发送系统通知</text></block></view></view><view wx:if="{{!missing && !petPicker}}" class="page-action-footer page-action-row"><button wx:if="{{id}}" class="secondary-button" bindtap="remove" disabled="{{saving}}">删除</button><button class="primary-button" bindtap="save" loading="{{saving}}" disabled="{{saving || !title || !time || (repeatId === 'weekly' ? weekdayIndex < 0 : repeatId !== 'daily' && !date)}}">保存</button></view>
<view wx:if="{{petPicker}}" class="sheet-mask" bindtap="closePets"></view><view wx:if="{{petPicker}}" class="bottom-sheet"><view class="sheet-heading"><text>关联宠物</text><button bindtap="closePets" aria-label="关闭"><p-icon name="close" /></button></view><button class="reminder-pet" data-id="" bindtap="selectPet"><text>不关联宠物</text><p-icon wx:if="{{!petId}}" name="check" size="28" /></button><button wx:for="{{pets}}" wx:key="id" class="reminder-pet" data-id="{{item.id}}" bindtap="selectPet"><p-image wx:if="{{item.image}}" image-class="reminder-avatar" src="{{item.image}}" /><view wx:else class="reminder-icon"><p-icon name="{{item.type === '狗狗' ? 'dog' : 'cat'}}" size="32" /></view><text>{{item.name}}</text><p-icon wx:if="{{item.id === petId}}" name="check" size="28" /></button></view>
