<view class="guzi-page {{state === 'editing' ? 'editing-page' : ''}} {{state === 'generating' ? 'generating-page' : ''}} {{state === 'success' ? 'result-page' : ''}} {{inputFocused ? 'keyboard-open' : ''}}">
  <view class="guzi-header"><page-header title="生成谷子" back custom-back bind:back="leavePage" /></view>
  <view class="guzi-body">
    <block wx:if="{{state === 'editing'}}">
      <view class="guzi-title">{{photoPath ? '这次，让它成为主角' : '让可爱，有“徽”可藏'}}</view>
      <view wx:if="{{!photoPath}}" class="guzi-card upload-card">
        <view class="badge-example">
          <view class="badge-mockup">
            <view class="badge-face"><image src="{{demoImage}}" mode="aspectFill" /><view class="badge-gloss"></view></view>
          </view>
          <text class="small-label">58mm 徽章效果</text>
        </view>
        <button class="upload-zone" bindtap="choosePhoto" disabled="{{choosing}}">
          <view class="upload-plus"><p-icon name="plus" size="28" /></view>
          <text class="upload-action">上传宠物照片</text>
          <text class="upload-format">JPG / PNG · 10MB 内</text>
        </button>
      </view>
      <view wx:else class="guzi-card photo-card">
        <view class="photo-wrap">
          <image class="selected-photo" src="{{photoPath}}" mode="aspectFill" />
          <button class="icon-button crop-button" bindtap="recropPhoto" aria-label="裁剪照片"><image src="assets/crop.svg" /></button>
        </view>
        <button class="icon-button replace-button" bindtap="choosePhoto" disabled="{{choosing}}" aria-label="更换照片"><image src="assets/replace.svg" /></button>
      </view>
      <view class="guzi-card prompt-card">
        <view wx:if="{{badgeStyles.length}}" class="style-tags mode-tabs">
          <button class="style-tag {{mode === 'prompt' ? 'active' : ''}}" data-mode="prompt" bindtap="setMode">自定义头像</button>
          <button class="style-tag {{mode === 'badge' ? 'active' : ''}}" data-mode="badge" bindtap="setMode">徽章转绘</button>
        </view>
        <view wx:if="{{mode === 'badge'}}">
          <text class="card-title">选择徽章风格</text>
          <view class="style-tags badge-styles">
            <button wx:for="{{badgeStyles}}" wx:key="id" class="style-tag {{badgeStyle === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectBadgeStyle">{{item.name}}</button>
          </view>
        </view>
        <block wx:else>
          <text class="card-title">风格描述</text>
          <view wx:if="{{promptStyles.length || stylesLoading || stylesError}}" class="style-tags">
            <button wx:for="{{promptStyles}}" wx:key="id" class="style-tag {{selectedStyle === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectPromptStyle" aria-label="{{item.name}}，{{selectedStyle === item.id ? '已选中' : '未选中'}}">{{item.name}}</button>
            <text wx:if="{{stylesLoading}}" class="small-label">加载风格中…</text>
            <button wx:elif="{{stylesError}}" class="style-tag" bindtap="loadPromptStyles">重试加载风格</button>
          </view>
          <view class="prompt-editor">
            <textarea class="prompt-input" value="{{prompt}}" auto-height="{{false}}" maxlength="-1" placeholder="描述你想要的头像" bindinput="onPromptInput" bindfocus="onPromptFocus" bindblur="onPromptBlur" cursor-spacing="100" show-confirm-bar="{{false}}" />
          </view>
          <text class="word-count">{{promptCount}} / {{promptLimit}}</text>
        </block>
        <text wx:if="{{error}}" class="field-error">{{error}}</text>
      </view>
    </block>
    <block wx:elif="{{state === 'generating'}}">
      <view class="generation-card">
        <view class="scan-photo">
          <image src="{{photoPath}}" mode="aspectFill" />
          <view class="scan-shade"></view><view class="scan-light"></view>
        </view>
        <text class="generation-label">{{generationLabel}}</text>
      </view>
    </block>
    <block wx:elif="{{state === 'success'}}">
      <view class="result-heading">
        <view class="guzi-title">你的专属谷子，诞生啦！</view>
        <image class="title-underline" src="assets/result/underline.svg" mode="aspectFit" aria-hidden="true" />
        <image class="title-celebrate" src="assets/result/celebrate.svg" mode="aspectFit" aria-hidden="true" />
        <text class="result-subtitle">把爱宠变成独一无二的徽章吧～</text>
        <image class="heading-paw" src="assets/result/paw-purple.svg" mode="aspectFit" aria-hidden="true" />
      </view>
      <text wx:if="{{isDemo}}" class="demo-label">示例预览</text>
      <view class="preview-tabs">
        <button class="{{preview === 'avatar' ? 'active' : ''}}" data-mode="avatar" bindtap="setPreview" aria-label="头像，{{preview === 'avatar' ? '已选中' : '未选中'}}"><image src="assets/result/user-round.svg" mode="aspectFit" />头像</button>
        <button class="{{preview === 'badge' ? 'active' : ''}}" data-mode="badge" bindtap="setPreview" aria-label="58mm 徽章，{{preview === 'badge' ? '已选中' : '未选中'}}"><image src="assets/result/award.svg" mode="aspectFit" />58mm 徽章</button>
      </view>
      <view class="result-card">
        <view class="result-artwork {{preview === 'badge' ? 'badge-preview' : 'avatar-preview'}}" bindtap="previewResult" role="button" aria-label="查看生成图片大图，可长按保存">
          <image class="result-image {{preview === 'badge' ? 'badge' : ''}}" src="{{resultPath}}" mode="{{preview === 'badge' ? 'aspectFill' : 'aspectFit'}}" />
          <view wx:if="{{preview === 'badge'}}" class="result-gloss"></view>
          <image class="badge-celebrate" src="assets/result/badge-spark.svg" mode="aspectFit" aria-hidden="true" />
          <image class="result-paw" src="assets/result/paw-pink.svg" mode="aspectFit" aria-hidden="true" />
        </view>
        <view wx:if="{{preview === 'badge'}}" class="dimension"><view></view><text>58 mm</text><view></view></view>
        <text wx:else class="avatar-dimension">1 : 1 头像</text>
        <text class="preview-save-hint">点击查看大图 · 长按可保存</text>
      </view>
    </block>
    <block wx:elif="{{state === 'failed'}}">
      <view class="guzi-title">这次没能画出来</view>
      <view class="guzi-card error-card"><text class="card-title">生成失败</text><text>{{error}}</text></view>
      <view class="guzi-card retained-input"><image src="{{photoPath}}" mode="aspectFill" /><text>{{mode === 'badge' ? badgeName : prompt}}</text></view>
    </block>
  </view>
  <view wx:if="{{!inputFocused}}" class="guzi-footer">
    <block wx:if="{{state === 'editing'}}"><button class="primary" disabled="{{!photoPath || (mode === 'badge' ? !badgeStyle : !promptValid) || choosing}}" bindtap="generate">{{photoPath ? (mode === 'badge' ? '生成宠物徽章' : '生成卡通头像') : '先上传宠物照片'}}</button></block>
    <button wx:elif="{{state === 'generating'}}" class="primary" disabled>正在生成，请稍候</button>
    <block wx:elif="{{state === 'success'}}">
      <view class="result-actions">
        <button class="secondary" loading="{{saving}}" disabled="{{saving || sharing}}" bindtap="saveImage"><image wx:if="{{!saving}}" class="result-action-icon" src="assets/result/download.svg" mode="aspectFit" />{{isDemo ? '保存图像' : '保存图像'}}</button>
        <button class="primary" loading="{{sharing}}" disabled="{{sharing || saving}}" bindtap="showOff"><image wx:if="{{!sharing}}" class="result-action-icon" src="assets/result/wand-sparkles.svg" mode="aspectFit" />秀一下</button>
      </view>
      <button class="secondary" bindtap="recreate" disabled="{{sharing}}"><image class="result-action-icon" src="assets/result/rotate-cw.svg" mode="aspectFit" />重新创作</button>
    </block>
    <block wx:else><button class="primary" bindtap="generate">重新尝试</button><button class="secondary" bindtap="recreate">重新创作</button></block>
  </view>
  <view wx:if="{{state === 'success'}}" class="result-bottom-art" aria-hidden="true">
    <image class="result-waves" src="assets/result/cat-waves.svg" mode="scaleToFill" />
    <image class="result-yarn" src="assets/result/yarn.svg" mode="aspectFit" />
  </view>
</view>
