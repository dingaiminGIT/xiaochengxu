<view class="page tab-page home-page"><view class="home-theme-backdrop" aria-hidden="true"><view class="home-theme-curve"></view></view><page-header title="首页" inverse /><view class="screen-body">
  <view class="pet-calendar">
  <view class="calendar-heading"><button class="calendar-pet" bindtap="openPetPage"><view class="daily-pet-button"><view class="daily-pet-image"><p-image wx:if="{{pet.image}}" image-class="daily-pet-photo" src="{{pet.image}}" /><p-icon wx:else name="{{pet.type === '狗狗' ? 'dog' : 'cat'}}" size="28" /></view></view><view class="calendar-pet-copy"><text>{{pet.name || '添加爱宠'}}</text><text class="caption">{{pet.age_text || (pet.age ? pet.age + '岁' : '记录陪伴的每一天')}}</text></view></button><button class="text-button calendar-more" bindtap="openAllReminders">全部<p-icon name="arrow" size="22" /></button></view>
  <view class="home-calendar-days"><button wx:for="{{calendarDays}}" wx:key="key" class="calendar-day {{!item.count ? 'no-reminder' : ''}} {{item.selected && item.count ? 'selected' : ''}} {{item.today ? 'today' : ''}} {{item.today && item.count ? 'today-reminder' : ''}}" hover-class="{{item.count ? 'button-hover' : 'none'}}" data-date="{{item.key}}" bindtap="chooseCalendarDay"><view class="calendar-day-inner"><text class="calendar-week">周{{item.week}}</text><text class="calendar-number">{{item.day}}</text><view class="calendar-dot {{item.count ? 'has-reminder' : ''}}"></view></view></button></view>
  <button class="calendar-summary" bindtap="openCalendar"><p-icon name="alarm" size="26" /><text>{{calendarSummary}}</text><p-icon name="arrow" size="22" /></button>
</view>
<view class="daily-card"><view class="daily-head"><text class="daily-title">今日状态</text><button class="text-button" bindtap="goHistory">历史<p-icon name="arrow" size="22" /></button></view><view class="daily-metrics"><button wx:for="{{metrics}}" wx:key="key" class="metric" data-key="{{item.key}}" bindtap="openRecord"><view class="metric-label"><p-icon name="{{item.key}}" size="28" tone="primary" /><text>{{item.label}}</text></view><view class="metric-number">{{item.value}}<text>{{item.unit}}</text><text wx:if="{{item.status}}" class="metric-status">{{item.status}}</text></view></button></view><view class="daily-foot"><button class="text-button" bindtap="openDevices"><p-icon name="device" size="30" />连接设备<view class="device-dot"></view></button><button class="record-button" bindtap="openRecord"><p-icon name="plus" size="24" />记一下</button></view></view>
  <view class="section-heading"><text>大家都在聊</text><text>真实经历，相互陪伴</text></view><view class="search-box"><p-icon name="search" tone="muted" size="32" /><input placeholder="搜一搜，宠物遇到的小问题" value="{{query}}" bindinput="onSearch" /></view><view class="category-tabs"><button wx:for="{{categories}}" wx:key="id" class="category-tab {{category === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.label}}</button></view><view wx:if="{{loading}}" class="empty-state">正在加载大家的分享…</view><view wx:if="{{feedError}}" class="empty-state">{{feedError}}<button class="text-button" bindtap="loadFeed">重新加载</button></view><post-feed posts="{{posts}}" bind:open="openPost" bind:save="toggleSave" /><view wx:if="{{!posts.length && !loading && !feedError}}" class="empty-state">没有找到相关帖子，试试其他关键词。</view>
</view><button class="floating-publish" bindtap="goRelease" aria-label="发个帖子"><view class="publish-disc"><p-icon name="edit" tone="inverse" size="40" /></view></button></view>
<view wx:if="{{showRecord || showDevices}}" class="sheet-mask" bindtap="closeSheet"></view>
<view wx:if="{{showRecord}}" class="bottom-sheet"><view class="sheet-heading"><text>{{recordTitle}}</text><button bindtap="closeSheet" aria-label="关闭"><p-icon name="close" /></button></view>
<text class="caption">填写本次值，保存后自动累加到今天。{{recordFields.length > 1 ? '可只填写需要记录的项目。' : ''}}</text>
<view wx:for="{{recordFields}}" wx:key="key" class="form-field"><view class="record-field-heading"><text>{{item.label}}（{{item.unit}}）</text><text class="record-total">今日累计 {{item.total}} {{item.unit}}</text></view><view wx:if="{{item.key === 'litter'}}" class="litter-inputs"><view class="litter-count"><input type="number" data-key="litter" value="{{form.litter}}" placeholder="例如1次" aria-label="排便次数" bindinput="onRecordInput" /></view><view class="litter-shape"><input data-key="litterShape" value="{{form.litterShape}}" maxlength="60" placeholder="软, 硬, 血便, 毛球等" aria-label="便便形态，选填，默认正常" bindinput="onRecordInput" /></view></view><input wx:else type="digit" data-key="{{item.key}}" value="{{form[item.key]}}" placeholder="{{item.key === 'water' ? '例如 50' : '例如 20'}}" bindinput="onRecordInput" /></view>
<text class="caption">记录保存在当前设备。</text><button class="primary-button" bindtap="saveRecord">保存本次记录</button></view>
<view wx:if="{{showDevices}}" class="bottom-sheet"><view class="sheet-heading"><text>我的设备</text><button bindtap="closeSheet" aria-label="关闭"><p-icon name="close" /></button></view><view class="device-intro"><p-icon name="device" size="76" /><text>让陪伴，多一点了解</text><text class="caption">硬件接入准备中，可先手动记录日常。</text></view><view wx:for="{{metrics}}" wx:key="key" class="menu-row"><p-icon name="{{item.key}}" /><view class="row-copy">{{item.key === 'water' ? '智能饮水机' : item.key === 'food' ? '智能喂食器' : '智能猫砂盆'}}</view><text class="caption">待接入</text></view></view>
