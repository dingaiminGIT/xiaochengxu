.guardian-report{color:#24213d;font-size:26rpx;line-height:1.65;min-width:0}.report-header{padding:26rpx 22rpx;background:linear-gradient(135deg,#f4f0ff,#fafbff);border-radius:24rpx}.eyebrow{display:block;color:#7961d8;font-size:22rpx;font-weight:600}.report-title{display:block;margin:8rpx 0 16rpx;font-size:34rpx;font-weight:700}.pet-tags{display:flex;gap:12rpx;flex-wrap:wrap}.pet-tags text{padding:4rpx 18rpx;border:1rpx solid #e5dcff;background:#fff;border-radius:28rpx;color:#6d4bd5;font-size:23rpx}.report-section{padding:22rpx;margin-top:16rpx;border:1rpx solid #eeeaf6;border-radius:20rpx;background:#fff}.summary{background:#faf8ff}.section-title{display:block;font-size:29rpx;font-weight:700;margin-bottom:12rpx}.body-text{display:block;white-space:pre-wrap;overflow-wrap:break-word;word-break:break-word;margin-top:8rpx}.note{display:block;font-size:23rpx;color:#77738b;white-space:pre-wrap;margin-top:12rpx;word-break:break-word}.report-tabs{display:flex;border-bottom:1rpx solid #eee8fa;margin-top:18rpx}.tab{flex:1;border-radius:0;background:transparent;color:#918aa4;font-size:27rpx;line-height:2.6;border-bottom:3rpx solid transparent}.tab::after,.score-toggle::after{border:0}.tab.active{color:#7348f5;border-color:#8056ff;font-weight:600}.product-heading{display:flex;gap:12rpx;align-items:baseline;justify-content:space-between;flex-wrap:wrap}.product-heading .section-title{flex:1;min-width:160rpx}.stage{font-size:21rpx;color:#9e6a16;background:#fff7e6;border-radius:10rpx;padding:2rpx 10rpx}.points{padding:18rpx;border-radius:16rpx;margin-top:14rpx}.strengths{background:#f3faf7}.cautions{background:#faf7f1}.point-heading{display:block;font-size:26rpx;font-weight:600}.points .body-text{font-size:25rpx}.score-toggle{background:#f4efff;border-radius:30rpx;padding:0 18rpx;margin:0;font-size:22rpx;line-height:2.2;color:#784ce3}.dimension{padding:16rpx 0;border-bottom:1rpx solid #f2eff8}.dimension-columns{display:flex;gap:24rpx;margin-top:8rpx}.dimension-side{flex:1;min-width:0}.dimension-value{font-size:22rpx;color:#716b85;display:block}.bar{height:10rpx;background:#f0eef4;border-radius:8rpx;overflow:hidden;margin-top:8rpx}.bar-fill{height:100%;border-radius:8rpx;background:#668bd0}.bar-fill.alternate{background:#42b584}.experience{padding:20rpx 0;border-top:1rpx solid #eeeaf6;margin-top:18rpx}.source{display:block;color:#8a82a0;font-size:21rpx;margin-top:10rpx}.next-steps{background:#f9f6ff}.comparison-pair+.comparison-pair{border-top:1rpx solid #eeeaf6;margin-top:20rpx;padding-top:12rpx}
