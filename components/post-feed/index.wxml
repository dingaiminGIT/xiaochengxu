<view class="feed {{appearance}}"><view wx:for="{{columns}}" wx:for-item="column" wx:for-index="columnIndex" wx:key="index" class="column"><view wx:for="{{column}}" wx:key="id" class="post"><button class="post-open" data-id="{{item.id}}" bindtap="open"><p-image wx:if="{{item.image}}" image-class="photo" src="{{item.image}}" mode="widthFix" data-src="{{item.image}}" bindload="imageLoaded" lazy-load /><view wx:if="{{appearance !== 'airy'}}" class="tag"># {{item.tag}}</view><text class="title">{{item.title}}</text><view wx:if="{{appearance === 'airy'}}" class="tag"># {{item.tag}}</view></button><view class="meta"><view class="byline"><text class="byline-text {{item.author === '宠析官方' ? 'official-author' : ''}}">{{item.author}}</text><text class="byline-text time">{{item.editedText}}编辑</text></view><button wx:if="{{allowSave}}" class="save" data-id="{{item.id}}" catchtap="save" aria-label="{{item.saved ? '取消收藏' : '收藏'}}"><image wx:if="{{appearance === 'airy' && !item.saved}}" class="save-image" src="/static/design/home-save.svg" /><p-icon wx:else name="{{item.saved ? 'saved' : 'save'}}" tone="{{item.saved ? 'primary' : 'muted'}}" size="30" /></button></view></view></view></view>
